# Optional DSH Candidate deployment overrides. Empty values leave the
# SDK/profile defaults in control.
CANDIDATE_BASE_URL=
CANDIDATE_API_KEY=
CANDIDATE_MODEL_NAME=

# Optional, independent OpenAI-compatible judge configuration. These values
# may remain empty unless a selected Case contains a model-graded assertion
# such as `llm-rubric`. Base URL normally ends in `/v1`.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL_NAME=
